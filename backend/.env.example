PROJECT_NAME=TeamMemoryOS
APP_ENV=development
API_V1_PREFIX=/api/v1

# CORS — space-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# IBM Granite / watsonx.ai
# Set GRANITE_PROVIDER=stub for local development (no credentials needed).
# Set GRANITE_PROVIDER=granite to use the real IBM watsonx.ai endpoint.
GRANITE_PROVIDER=stub
GRANITE_API_KEY=
GRANITE_BASE_URL=
GRANITE_MODEL_ID=
GRANITE_PROJECT_ID=
GRANITE_MAX_TOKENS=
GRANITE_MAX_PROMPT_CHARS=
