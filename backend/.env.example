PROJECT_NAME=TeamMemoryOS
APP_ENV=development
API_V1_PREFIX=/api/v1

# CORS — space-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# LLM Provider Configuration
# Set LLM_PROVIDER=ollama for local Ollama, or LLM_PROVIDER=stub for deterministic testing
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=1024

# Embedding Provider Configuration
# Set EMBEDDING_PROVIDER=ollama for local Ollama, or EMBEDDING_PROVIDER=stub for testing
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_CACHE_SIZE=5000

# Legacy / Alternative Provider Settings (Optional)
GRANITE_PROVIDER=stub
GRANITE_API_KEY=
GRANITE_BASE_URL=https://us-south.ml.cloud.ibm.com/ml/v1
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
GRANITE_PROJECT_ID=
GRANITE_MAX_TOKENS=1024
GRANITE_MAX_PROMPT_CHARS=8000
