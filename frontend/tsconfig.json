{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./app/*"],
      "@components/*": ["./components/*"],
      "@config/*": ["./config/*"],
      "@features/*": ["./features/*"],
      "@hooks/*": ["./hooks/*"],
      "@layouts/*": ["./layouts/*"],
      "@lib/*": ["./lib/*"],
      "@providers/*": ["./providers/*"],
      "@services/*": ["./services/*"],
      "@stores/*": ["./stores/*"],
      "@styles/*": ["./styles/*"],
      "@typedefs/*": ["./types/*"],
      "@utils/*": ["./utils/*"]
    }
  },
  "include": [
    "src",
    "app",
    "components",
    "config",
    "features",
    "hooks",
    "layouts",
    "lib",
    "providers",
    "services",
    "stores",
    "tests",
    "types",
    "vite-env.d.ts",
    "utils"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
